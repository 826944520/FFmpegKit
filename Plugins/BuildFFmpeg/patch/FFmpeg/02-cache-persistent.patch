     close(c->fd);
     if (c->filename) {
+        /* only the anonymous temp branch sets filename; persistent cache
+         * files are kept for the next session (play-while-cache). */
         ret = unlink(c->filename);
         if (ret < 0)
             av_log(h, AV_LOG_ERROR, "Could not delete %s.\n", c->filename);
@@ -322,6 +372,7 @@ static int cache_close(URLContext *h)
 
